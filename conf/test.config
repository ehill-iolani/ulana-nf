params {
    // tests/data/ holds small synthetic fixtures generated by
    // tests/data/generate_synthetic_reads.py -- two samples, each simulated
    // long-read coverage of its own random 5-6kb "genome"
    input = 'tests/data/samplesheet.csv'

    chopper_q         = 8
    chopper_minlength = 400

    // amrfinder needs a multi-GB reference database fetched at runtime --
    // not practical for CI, so it's off in this profile. Everything else
    // needs no interactive setup (prokka bundles its own db, the
    // ontresearch/medaka image bundles the model, and CHECKM_DB fetches
    // checkm's ~275MB reference data itself), so they stay on to exercise
    // the full pipeline.
    enable_medaka    = true
    enable_prokka    = true
    enable_checkm    = true
    enable_id_genes  = true
    enable_amrfinder = false
}
