params {
    // tests/data/ holds small synthetic fixtures generated by
    // tests/data/generate_synthetic_reads.py -- two samples, each simulated
    // long-read coverage of its own random 5-6kb "genome"
    input = 'tests/data/samplesheet.csv'

    chopper_q         = 8
    chopper_minlength = 400

    // amrfinder needs a multi-GB reference database fetched at runtime --
    // not practical for CI, so it's off in this profile. Everything else
    // needs no interactive setup (prokka bundles its own db, the
    // ontresearch/medaka image bundles the model, and CHECKM_DB fetches
    // checkm's ~275MB reference data itself), so they stay on to exercise
    // the full pipeline.
    enable_medaka    = true
    enable_prokka    = true
    enable_checkm    = true
    enable_id_genes  = true
    enable_amrfinder = false

    // the samplesheet's organism/strain/locus_tag columns are there for
    // this; sample_b has no strain, to cover a named species without one
    enable_genbank   = true

    // a one-genome type-strain snapshot (tests/data/generate_test_typestrains.py):
    // sample_a's own synthetic genome as the "type strain", so sample_a comes out
    // the same species and sample_b has no hit. The real snapshot is ~51 GB
    enable_species_check = true
    species_db           = "${projectDir}/tests/data/typestrains"

    // the snapshot also holds three made-up relatives of sample_a (about 94,
    // 90 and 86% ANI), so sample_a gets a tree and sample_b (no hit) doesn't.
    // The genomes are random sequence with no marker genes: a plain test run
    // ends in too_few_marker_genes; CI adds -stub-run, where SPECIES_TREE
    // writes a star tree over the real labels instead (modules/species_tree.nf)
    enable_species_tree  = true
}

process {
    // GitHub Actions' ubuntu-latest runners have 4 CPUs / 16GB RAM total --
    // process_high (FLYE_ASSEMBLY) alone requests 8 CPUs, and Nextflow's
    // local executor errors out immediately if a task requests more CPUs
    // than the machine has (it doesn't queue/throttle), so every label needs
    // capping down to what the runner can actually give it
    resourceLimits = [ cpus: 4, memory: 6.GB, time: 1.h ]
}
