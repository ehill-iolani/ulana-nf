manifest {
    name            = 'ulana-nf'
    description     = 'Bacterial WGS assembly and characterization from ONT long reads (Nextflow port of ulana-ht)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.3.0'
}

params {
    // see main.nf for the full param list / help text
    outdir   = "results"
    tracedir = "${params.outdir}/pipeline_info"

    // where each module's container image is pulled from, read directly by the
    // modules' `container` directives (hence declared here). These defaults are
    // the upstream registries; the google_batch profile points both at the
    // project's own Artifact Registry mirror (scripts/mirror_images.sh) so a run
    // doesn't depend on quay.io / Docker Hub being reachable from every Batch VM
    container_registry = 'quay.io'
    dockerhub_registry = 'docker.io'

    // declared here (not as script-level `params.x = value` in main.nf) so
    // they're reliably set before any included module/workflow script reads
    // them -- same reasoning as edna-ont-nf's nextflow.config
    chopper_q         = 10
    chopper_minlength = 1000

    // read-length/Q-score summary before vs. after filtering (read_qc/read_qc_summary.html)
    enable_read_stats = true

    // cap each sample's depth before assembly (modules/downsample.nf): Flye
    // fails on very deep runs (a ~91 kb phage at ~5,000x). genome_size is e.g.
    // "92kb" or "5.5mb"; left blank, LRGE estimates it from each sample's reads.
    // A sample below target_coverage keeps every filtered read
    enable_downsampling = true
    target_coverage     = 150
    genome_size         = null

    flye_mode = "--nano-hq"

    bandage_height = 1000

    medaka_model = "r1041_e82_400bps_hac_v5.0.0"

    // feature toggles -- default to ulana-ht's config/config.yaml defaults,
    // except enable_bandage which has no Snakemake-original equivalent
    enable_medaka    = true
    enable_bandage   = true
    enable_prokka    = true
    enable_checkm    = true
    enable_id_genes  = true
    enable_amrfinder = true

    // GenBank submission files (genbank/), needs the samplesheet's organism
    // and locus_tag columns; off by default since most runs aren't submitted.
    // genbank_template is the NCBI submitter template (.sbt), optional
    enable_genbank   = false
    genbank_template = null

    // species check (modules/species_check.nf): skani ANI against NCBI's
    // bacterial type-strain genomes, plus the 16S copies against NCBI's 16S
    // type-strain db. species_db is a snapshot folder from
    // scripts/build_typestrain_db.py (local path or gs://); with none the step
    // is skipped with a warning. The google_batch profile sets it
    enable_species_check = true
    species_db           = null

    // species tree (modules/species_tree.nf): a marker-gene tree of each
    // assembly with its closest type strains (GToTree + IQ-TREE), plus their
    // pairwise ANI. Needs the species check and a snapshot with lineage.tsv
    // and gtotree_hmms/ (scripts/build_typestrain_lineage.py)
    enable_species_tree  = true
}

// base resource sizes -- this has to come before `profiles {}` below: config
// blocks are applied in file order for the *same* path, so a profile's own
// process{} overrides (e.g. google_batch's) only stick if this unconditional
// block is written first and the profile's block comes after it
process {
    withLabel: process_low {
        cpus   = 2
        memory = 4.GB
        time   = 1.h
    }
    withLabel: process_medium {
        cpus   = 4
        memory = 8.GB
        time   = 4.h
    }
    withLabel: process_high {
        cpus   = 8
        memory = 16.GB
        time   = 8.h
    }
}

profiles {
    docker {
        docker.enabled = true
        conda.enabled  = false
        docker.runOptions = '--platform linux/amd64'
    }
    conda {
        conda.enabled  = true
        docker.enabled = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
        // set process.queue / clusterOptions per institution HPC as needed
    }
    test {
        includeConfig 'conf/test.config'
    }
    google_batch {
        google.project        = 'iscc-400300'
        google.location       = 'us-central1'
        google.batch.spot     = true

        workDir               = 'gs://nextflow-jobs/ulana/work'
        // outdir/tracedir are deliberately not set here: the backend passes
        // --outdir per job, and a hardcoded tracedir here would ignore it and
        // send pipeline_info to one shared path instead of the job's results

        docker.enabled        = true

        // images come from our own mirror, not quay.io / Docker Hub (see the
        // params block); the mirror keeps each image's upstream path, so both
        // registries are one repo. Override with --container_registry quay.io
        // --dockerhub_registry docker.io to pull from upstream instead
        params.container_registry = 'us-central1-docker.pkg.dev/iscc-400300/containers'
        params.dockerhub_registry = 'us-central1-docker.pkg.dev/iscc-400300/containers'

        // the type-strain snapshot for the species check, built by
        // scripts/build_typestrain_db.py (about 51 GB; a run reads the 11 GB
        // sketch/, typestrains.tsv, build_info.json and the 16S BLAST files).
        // A new snapshot is a new dated folder, so old results stay traceable
        params.species_db = 'gs://nextflow-jobs/ulana/db_cache/typestrains/2026-11'

        // the top-level process_low/medium/high sizes below are tuned for a
        // laptop/CI running the tiny -profile test fixtures -- on a real
        // sample they're not enough (see CHECKM's own comment: pplacer alone
        // got OOM-killed at 12GB against a real genome even with
        // --reduced_tree). Google Batch provisions a fresh VM per task, so
        // there's no shared-machine contention pushing back on going bigger.
        //
        // everything process-scoped lives in this ONE block: mixing dotted
        // `process.x = ...` assignments with a nested `process { }` block in
        // the same profile makes the block replace the dotted settings
        // (executor/container/etc. silently vanish -> falls back to the local
        // executor), so don't split them
        process {
            executor      = 'google-batch'
            // Retry when Batch never gave a usable exit code -- a failed image
            // pull, a lost VM or a hit time limit all arrive as Nextflow's "no
            // exit status" (Integer.MAX_VALUE, printed as "-") -- or reports a
            // Batch-level code (>= 50000: 50001 Spot preemption, 50006 a Spot
            // VM recreated, which stopped a task on a 31-sample ulana-phage-nf
            // validation run, 2026-11-10). A script that really exited 1-255 is
            // deterministic, so retrying only repeats it: that fails at once.
            // Same rule as ulana-phage-nf / edna-ont-nf / 16S-nf / ITS-nf.
            errorStrategy = {
                (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus >= 50000)
                    ? 'retry' : 'terminate'
            }
            maxRetries    = 5
            // a closure so it still follows --dockerhub_registry when that's
            // overridden from the params file, after this profile is read
            container     = { "${params.dockerhub_registry}/library/ubuntu:22.04" }

            withLabel: process_low {
                cpus   = 4
                memory = 16.GB
                time   = 2.h
            }
            withLabel: process_medium {
                cpus   = 8
                memory = 32.GB
                time   = 6.h
            }
            withLabel: process_high {
                cpus   = 16
                memory = 64.GB
                time   = 12.h
            }
            // no label of its own (see modules/checkm.nf) -- pplacer is the
            // one step in this whole pipeline that's memory- rather than
            // cpu-bound, so it gets a highmem-shaped allocation instead of
            // reusing process_high
            withName: 'CHECKM' {
                cpus   = 8
                memory = 64.GB
                time   = 6.h
            }
        }
    }
}

timeline {
    enabled   = true
    file      = "${params.tracedir}/timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.tracedir}/report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.tracedir}/trace.txt"
    overwrite = true
}
